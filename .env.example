# npm start works locally with the bundled demo accounts.
NODE_ENV=development
PORT=3000
# Defaults to loopback in development and all interfaces in production.
HOST=

# Paths are resolved from the project working directory.
DATA_DIR=./data
# Set these only to override the locations under DATA_DIR.
DB_PATH=
UPLOAD_DIR=

# Production boot requires a valid owner email and a unique password of 12–128 characters.
OWNER_NAME="Learnity Platform Owner"
OWNER_EMAIL=
OWNER_PASSWORD=

# SMTP supports verified implicit TLS (465) or STARTTLS (587).
# Leave providers empty to record applications without sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
RESEND_API_KEY=

# Set to true to use Python sqlite3 even when native Node SQLite is available.
USE_PYTHON_SQLITE=false
